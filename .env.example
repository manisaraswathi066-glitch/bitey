# =====================================================================
# BITETECH TECHNOLOGIES — ENVIRONMENT CONFIGURATION
# =====================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=generate_a_random_secret_key_for_production_use_e9f2a81c4e7

# Database Mode:
# Set to 'True' to run with the built-in SQLite database (no MySQL install needed)
# Set to 'False' to connect to WAMP Server MySQL
USE_SQLITE=True

# WAMP Server MySQL Settings (Used when USE_SQLITE=False)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bitetech_db

# Optional direct database connection string (overrides the above if set)
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/bitetech_db?charset=utf8mb4

# Security Settings (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=False

# Company Contact Overrides (Optional)
COMPANY_EMAIL=bitetechtechnologies@gmail.com
COMPANY_PHONE=7814332912
WHATSAPP_NUMBER=917814332912
STARTING_PRICE=599
